# Road to DevCon 8 — Environment Variables
# Copy this to .env and fill in your values

# ============================================================
# CLIENT-SIDE (VITE_ prefix = bundled into frontend JS)
# ============================================================

# Smart Contract Address (deployed on Sepolia testnet)
# Deploy QuizScores.sol via Remix, then paste the address here
VITE_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# ============================================================
# SERVER-SIDE ONLY (set in Vercel Dashboard, NOT in .env)
# These must NOT have the VITE_ prefix to stay server-side
# ============================================================

# Admin wallet private key (signs quiz scores server-side)
# ADMIN_PRIVATE_KEY=0xYOUR_ADMIN_PRIVATE_KEY
# ADMIN_ADDRESS=0xYOUR_ADMIN_WALLET_ADDRESS

# JWT secret for quiz session tokens (any random 32+ char string)
# JWT_SECRET=your-random-secret-string-here

# Sepolia RPC URL (defaults to https://rpc.sepolia.org)
# RPC_URL=https://rpc.sepolia.org
