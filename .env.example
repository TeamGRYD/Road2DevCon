# Road to DevCon 8 — Environment Variables
# Copy this to .env and fill in your values

# ============================================================
# CLIENT-SIDE (VITE_ prefix = bundled into frontend JS)
# ============================================================

# Active quiz contract (deployed on Sepolia testnet)
# Deploy QuizScoresV2.sol via Remix, then paste the address here
# (legacy QuizScores.sol addresses still work; the API detects the version)
VITE_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Shared profile registry (ProfileRegistry.sol)
# When unset, profiles are read from / registered on VITE_CONTRACT_ADDRESS
# VITE_PROFILE_REGISTRY_ADDRESS=0xYOUR_PROFILE_REGISTRY_ADDRESS_HERE

# Feed contract (FeedContract.sol). The Feed page needs this and the registry.
# VITE_FEED_CONTRACT_ADDRESS=0xYOUR_FEED_CONTRACT_ADDRESS_HERE

# Sepolia RPC URL (client-side, used by leaderboard)
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ============================================================
# SERVER-SIDE ONLY (set in Vercel Dashboard, NOT in .env)
# These must NOT have the VITE_ prefix to stay server-side
# ============================================================

# Admin wallet private key (signs quiz scores server-side)
# ADMIN_PRIVATE_KEY=0xYOUR_ADMIN_PRIVATE_KEY
# ADMIN_ADDRESS=0xYOUR_ADMIN_WALLET_ADDRESS

# JWT secret for quiz session tokens (any random 32+ char string)
# JWT_SECRET=your-random-secret-string-here

# Sepolia RPC URL (defaults to https://ethereum-sepolia-rpc.publicnode.com)
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
